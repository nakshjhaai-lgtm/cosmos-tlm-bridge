              "fullDescription": {
                "text": "Code targets DynamoDB/RDS/Aurora control-plane APIs rather than a portable wire protocol."
              },
              "help": {
                "text": "Use PostgreSQL (CloudNativePG) or an S3-backed open table format.",
                "markdown": "**Portable replacement:** CloudNativePG PostgreSQL cluster\n\nUse PostgreSQL (CloudNativePG) or an S3-backed open table format."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "database",
                "portability": "CloudNativePG PostgreSQL cluster",
                "severity": "high"
              }
            },
            {
              "id": "TPD012",
              "name": "AWSCLIinvocationofaproprietaryservice",
              "shortDescription": {
                "text": "AWS CLI invocation of a proprietary service"
              },
              "fullDescription": {
                "text": "A shell-out to the aws CLI targets an AWS control plane at deploy or run time."
              },
              "help": {
                "text": "Replace with kubectl/Helm or Crossplane; the ground station must not require AWS credentials.",
                "markdown": "**Portable replacement:** kubectl / Helm / Crossplane\n\nReplace with kubectl/Helm or Crossplane; the ground station must not require AWS credentials."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "compute",
                "portability": "kubectl / Helm / Crossplane",
                "severity": "high"
              }
